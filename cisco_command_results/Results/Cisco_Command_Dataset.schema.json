{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taig:cisco-command-dataset:1.0.0",
  "title": "TAIG Cisco command research dataset",
  "type": "object",
  "required": [
    "metadata",
    "commands",
    "task_categories",
    "tasks",
    "command_families",
    "task_workflows",
    "relationships",
    "sources",
    "platform_version_metadata"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_version",
        "completeness_claim"
      ],
      "properties": {
        "completeness_claim": {
          "const": false
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command_id",
          "syntax",
          "canonical_family",
          "task_ids",
          "task_category_id",
          "cli_modes",
          "syntax_elements",
          "source_ids",
          "support_status",
          "validation_status",
          "operational_risk",
          "negation_removal",
          "expected_output"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 1
          },
          "syntax": {
            "type": "string",
            "minLength": 1
          },
          "canonical_family": {
            "type": "string"
          },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "task_category_id": {
            "type": "string"
          },
          "cli_modes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "syntax_elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "description",
                "required",
                "range"
              ]
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "support_status": {
            "const": "documented_in_source_boundary_only"
          },
          "validation_status": {
            "const": "documentation_reviewed_not_device_tested"
          },
          "negation_removal": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_output": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operational_risk": {
            "type": "object",
            "required": [
              "effect",
              "level",
              "caution"
            ]
          }
        }
      }
    },
    "task_categories": {
      "type": "array"
    },
    "tasks": {
      "type": "array"
    },
    "command_families": {
      "type": "array"
    },
    "task_workflows": {
      "type": "array"
    },
    "relationships": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "platform_version_metadata": {
      "type": "object"
    }
  }
}
